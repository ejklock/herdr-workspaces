#!/bin/sh
# Copies this repository's mod and layout into a Herdr app home. Herdr draws a mod's SVGs and
# reloads its edits only from real files, so a link would not work; rerun after each change.
# Usage: bin/install <app home>
set -eu

if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
  echo "usage: bin/install <app home>" >&2
  exit 2
fi

repo=$(cd "$(dirname "$0")/.." && pwd -P)
home=$(cd "$1" && pwd -P)
mod_target="$home/mods/workspaces"
layout_target="$home/layouts/workspaces.json"
marker=.installed-from

points_into_repo() {
  case $(readlink "$1") in
    "$repo"/*) return 0 ;;
    *) return 1 ;;
  esac
}

own_copy() {
  [ -f "$mod_target/$marker" ] && [ "$(cat "$mod_target/$marker")" = "$repo" ]
}

# The mod folder may be absent, an earlier link into this repository, or this repository's own copy.
check_mod() {
  if [ -L "$mod_target" ]; then
    points_into_repo "$mod_target" && return 0
    echo "refusing $mod_target: a symlink pointing elsewhere" >&2
    return 1
  fi
  [ -e "$mod_target" ] || return 0
  own_copy && return 0
  echo "refusing $mod_target: not a copy made from $repo" >&2
  return 1
}

# A plain layout file carries no marker: it counts as ours only beside our own mod copy.
check_layout() {
  if [ -L "$layout_target" ]; then
    points_into_repo "$layout_target" && return 0
    echo "refusing $layout_target: a symlink pointing elsewhere" >&2
    return 1
  fi
  [ -e "$layout_target" ] || return 0
  own_copy && return 0
  echo "refusing $layout_target: exists and was not made by this script" >&2
  return 1
}

# The side-panel Files block names one mod and Herdr has no fallback, so the choice is made at install.
# Only the block's own "mod" value is rewritten; the anchor must match exactly once, and an unreadable
# source counts as no match.
source_layout="$repo/layouts/workspaces.json"
anchor='"mod": "files"'

check_anchor() {
  count=$(grep -cF "$anchor" "$source_layout" 2>/dev/null || true)
  [ "$count" = 1 ] && return 0
  echo "refusing: $source_layout must contain $anchor exactly once" >&2
  return 1
}

wanted() {
  case $1 in
    *.test.js | gpui-kit.d.ts | jsconfig.json) return 1 ;;
    *) return 0 ;;
  esac
}

# A link inside the copy would send a write outside the target, so it is removed before writing.
unlink_if_link() {
  if [ -L "$1" ]; then rm "$1"; fi
}

# Files are overwritten in place so Herdr's watcher sees a change; files gone from the source are removed.
copy_mod() {
  if [ -L "$mod_target" ]; then rm "$mod_target"; fi
  mkdir -p "$mod_target"
  # The marker goes first so a copy that fails partway is still recognised as ours on the next run.
  unlink_if_link "$mod_target/$marker"
  printf '%s' "$repo" > "$mod_target/$marker"
  for file in "$mod_target"/*; do
    [ -f "$file" ] || continue
    name=${file##*/}
    if [ ! -f "$repo/mods/workspaces/$name" ] || ! wanted "$name"; then rm "$file"; fi
  done
  for file in "$repo"/mods/workspaces/*; do
    [ -f "$file" ] || continue
    wanted "${file##*/}" || continue
    unlink_if_link "$mod_target/${file##*/}"
    cp "$file" "$mod_target/"
  done
  echo "copied $mod_target"
}

copy_layout() {
  files_mod=files
  [ -d "$home/mods/my-files" ] && files_mod=my-files
  if [ -L "$layout_target" ]; then rm "$layout_target"; fi
  sed "s/\"mod\": \"files\"/\"mod\": \"$files_mod\"/" "$source_layout" > "$layout_target"
  echo "copied $layout_target (Files mod: $files_mod)"
}

check_mod && check_layout && check_anchor || exit 1
mkdir -p "$home/mods" "$home/layouts"
copy_mod
copy_layout
