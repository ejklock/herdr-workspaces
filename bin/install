#!/bin/sh
# Copies this repository's workspaces mod, its layout and the optional plugins into a Herdr app home.
# Herdr draws a mod's SVGs and reloads its edits only from real files, so a link would not work; rerun
# after each change.
# Usage: bin/install [--without editor] <app home>
set -eu

usage() {
  echo "$1" >&2
  echo "usage: bin/install [--without editor] <app home>" >&2
  exit 2
}

repo=$(cd "$(dirname "$0")/.." && pwd -P)
with_editor=1
home_arg=
while [ "$#" -gt 0 ]; do
  case $1 in
    --without)
      [ "$#" -ge 2 ] || usage "--without needs a plugin name"
      [ "$2" = editor ] || usage "unknown plugin: $2"
      with_editor=0
      shift 2
      ;;
    -*) usage "unknown option: $1" ;;
    *)
      [ -z "$home_arg" ] || usage "only one app home is allowed"
      home_arg=$1
      shift
      ;;
  esac
done
[ -n "$home_arg" ] && [ -d "$home_arg" ] || usage "the app home must be an existing folder"

home=$(cd "$home_arg" && pwd -P)
plugin_dir="$repo/plugins/editor"
mod_target="$home/mods/workspaces"
layout_target="$home/layouts/Workspaces.json"
earlier_layout="$home/layouts/workspaces.json"
marker=.installed-from
# Names the project, not the checkout, so a copy made from any other checkout of it is still ours. An earlier
# install wrote the checkout's absolute path instead; only these installers ever wrote the file.
marker_text=herdr-workspaces

points_into_repo() {
  case $(readlink "$1") in
    "$repo"/*) return 0 ;;
    *) return 1 ;;
  esac
}

own_copy() {
  [ -f "$mod_target/$marker" ] || return 1
  case $(cat "$mod_target/$marker") in
    "$marker_text" | /*) return 0 ;;
    *) return 1 ;;
  esac
}

# The mod folder may be absent, an earlier link into this repository, or a copy this project made.
check_mod() {
  if [ -L "$mod_target" ]; then
    points_into_repo "$mod_target" && return 0
    echo "refusing $mod_target: a symlink pointing elsewhere" >&2
    return 1
  fi
  [ -e "$mod_target" ] || return 0
  own_copy && return 0
  echo "refusing $mod_target: not a copy made by herdr-workspaces" >&2
  return 1
}

# A plain layout file carries no marker: it counts as ours only beside a mod copy this project made. Both spellings are
# checked by name, so the result does not depend on whether the volume ignores case.
check_layout_file() {
  if [ -L "$1" ]; then
    points_into_repo "$1" && return 0
    echo "refusing $1: a symlink pointing elsewhere" >&2
    return 1
  fi
  [ -e "$1" ] || return 0
  own_copy && return 0
  echo "refusing $1: exists and was not made by this script" >&2
  return 1
}

check_layout() {
  check_layout_file "$layout_target" && check_layout_file "$earlier_layout"
}

# The side-panel Files and Changes blocks each name one mod and Herdr has no fallback, so the choice is made at install.
# Only the block's own "mod" value is rewritten; the anchor must match exactly once, and an unreadable
# source counts as no match.
source_layout="$repo/layouts/Workspaces.json"
anchor='"mod": "files"'
changes_anchor='"mod": "changes"'

check_one_anchor() {
  count=$(grep -cF "$1" "$source_layout" 2>/dev/null || true)
  [ "$count" = 1 ] && return 0
  echo "refusing: $source_layout must contain $1 exactly once" >&2
  return 1
}

check_anchor() {
  check_one_anchor "$anchor" && check_one_anchor "$changes_anchor"
}

wanted() {
  case $1 in
    *.test.js | gpui-kit.d.ts | jsconfig.json) return 1 ;;
    *) return 0 ;;
  esac
}

# A link inside the copy would send a write outside the target, so it is removed before writing.
unlink_if_link() {
  if [ -L "$1" ]; then rm "$1"; fi
}

# Files are overwritten in place so Herdr's watcher sees a change; files gone from the source are removed.
copy_mod() {
  if [ -L "$mod_target" ]; then rm "$mod_target"; fi
  mkdir -p "$mod_target"
  # The marker goes first so a copy that fails partway is still recognised as ours on the next run.
  unlink_if_link "$mod_target/$marker"
  printf '%s' "$marker_text" > "$mod_target/$marker"
  for file in "$mod_target"/*; do
    [ -f "$file" ] || continue
    name=${file##*/}
    if [ ! -f "$repo/mods/workspaces/$name" ] || ! wanted "$name"; then rm "$file"; fi
  done
  for file in "$repo"/mods/workspaces/*; do
    [ -f "$file" ] || continue
    wanted "${file##*/}" || continue
    unlink_if_link "$mod_target/${file##*/}"
    cp "$file" "$mod_target/"
  done
  echo "copied $mod_target"
}

copy_layout() {
  files_mod=files
  changes_mod=changes
  if [ "$with_editor" = 1 ]; then
    files_mod=my-files
    changes_mod=my-changes
  fi
  # The layout is written in place, like the mod files, so Herdr's watcher sees the change; only a link is
  # removed first. The earlier lower-case file is removed only when the folder lists that exact name: on a
  # volume that ignores case, a plain rm of it would delete the current file too.
  unlink_if_link "$layout_target"
  if ls -1 "$home/layouts" 2>/dev/null | grep -qx 'workspaces.json'; then rm -f "$earlier_layout"; fi
  sed -e "s/\"mod\": \"files\"/\"mod\": \"$files_mod\"/" -e "s/\"mod\": \"changes\"/\"mod\": \"$changes_mod\"/" "$source_layout" > "$layout_target"
  echo "copied $layout_target (Files mod: $files_mod, Changes mod: $changes_mod)"
}

# The plugin's installer refuses a hostile target before it writes, and this runs before any workspaces
# copy, so a refusal leaves the home untouched; a failed build stops here too.
install_editor() {
  (cd "$plugin_dir" && npm run build --silent) || { echo "refusing: the editor plugin build failed" >&2; return 1; }
  sh "$plugin_dir/bin/install-files" "$home"
}

check_mod && check_layout && check_anchor || exit 1
if [ "$with_editor" = 1 ]; then install_editor || exit 1; fi
mkdir -p "$home/mods" "$home/layouts"
copy_mod
copy_layout
