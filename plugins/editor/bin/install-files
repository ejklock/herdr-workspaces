#!/bin/sh
# Copies this plugin's built editor, my-files, my-changes and my-diff mods into a Herdr app home. Herdr draws a mod's
# SVGs and reloads its edits only from real files, so a link would not work; rerun after each build.
# Usage: bin/install-files <app home>
set -eu

if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then
  echo "usage: bin/install-files <app home>" >&2
  exit 2
fi

repo=$(cd "$(dirname "$0")/.." && pwd -P)
home=$(cd "$1" && pwd -P)
marker=.installed-from
# Names the project, not the checkout, so a copy made from any other checkout of it is still ours. An earlier
# install wrote the plugin's absolute path instead; only these installers ever wrote the file.
marker_text=herdr-workspaces

for built in editor/editor/main.js my-files/files/main.js my-changes/list/main.js my-diff/changes/pane.js; do
  if [ ! -f "$repo/mods/$built" ]; then
    echo "the build output $repo/mods/$built is missing: run npm run build first" >&2
    exit 1
  fi
done

# A target may be absent, an earlier link into this repository, or a copy this project made.
check_target() {
  target="$home/mods/$1"
  if [ -L "$target" ]; then
    case $(readlink "$target") in
      "$repo"/*) return 0 ;;
    esac
    echo "refusing $target: a symlink pointing elsewhere" >&2
    return 1
  fi
  [ -e "$target" ] || return 0
  # A marker that is a link proves nothing and would send the marker write outside the target.
  if [ ! -L "$target/$marker" ] && [ -f "$target/$marker" ]; then
    case $(cat "$target/$marker") in
      "$marker_text" | /*) return 0 ;;
    esac
  fi
  echo "refusing $target: not a copy made by herdr-workspaces" >&2
  return 1
}

wanted() {
  case $1 in
    *.test.js | *.d.ts | jsconfig.json) return 1 ;;
    *) return 0 ;;
  esac
}

# A link inside the copy would send a write outside the target, so it is removed before writing.
unlink_if_link() {
  if [ -L "$1" ]; then rm "$1"; fi
}

# Files are overwritten in place so Herdr's watcher sees a change; files gone from the source are removed.
sync_folder() {
  from=$1
  to=$2
  unlink_if_link "$to"
  mkdir -p "$to"
  for file in "$to"/*; do
    [ -f "$file" ] || [ -L "$file" ] || continue
    name=${file##*/}
    if [ ! -f "$from/$name" ] || ! wanted "$name"; then rm "$file"; fi
  done
  for file in "$from"/*; do
    [ -f "$file" ] || continue
    name=${file##*/}
    wanted "$name" || continue
    unlink_if_link "$to/$name"
    cp "$file" "$to/"
  done
}

# Usage: install_mod <mod name> <subfolder>...
install_mod() {
  mod=$1
  shift
  target="$home/mods/$mod"
  if [ -L "$target" ]; then rm "$target"; fi
  mkdir -p "$target"
  # The marker goes first so a copy that fails partway is still recognised as ours on the next run.
  printf '%s' "$marker_text" > "$target/$marker"
  sync_folder "$repo/mods/$mod" "$target"
  for sub in "$@"; do
    sync_folder "$repo/mods/$mod/$sub" "$target/$sub"
  done
  echo "copied $target"
}

check_target editor && check_target my-files && check_target my-changes && check_target my-diff || exit 1
mkdir -p "$home/mods"
install_mod editor editor format
install_mod my-files files icons
install_mod my-changes list
install_mod my-diff changes
